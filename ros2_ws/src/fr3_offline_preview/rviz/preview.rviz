Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.2
      Plane Cell Count: 15
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: FR3
      Enabled: true
      Alpha: 1
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 5
      Visual Enabled: true
      Collision Enabled: false
      Update Interval: 0
  Enabled: true
  Global Options:
    Background Color: 40; 40; 40
    Fixed Frame: base
    Frame Rate: 30
  Name: root
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.4
      Focal Point:
        X: 0.3
        Y: 0
        Z: 0.4
      Name: Current View
      Pitch: 0.4
      Target Frame: base
      Yaw: 0.8
Window Geometry:
  Width: 1200
  Height: 800
